{
  "expo": {
    "name": "Tissa",
    "slug": "tissa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/tissa.png",
    "scheme": "tissa",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.yourname.tissa",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/tissa.png",
        "backgroundColor": "#0F1B3D"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/tissa.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/tissa.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0F1B3D"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
